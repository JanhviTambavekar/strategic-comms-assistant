# Copy this file to .env and fill in ONE provider key.
# If none is set, the app runs in MOCK mode (no API needed) so the demo still works.

# LLM provider: "gemini", "anthropic", "openai", or "mock"
LLM_PROVIDER=mock

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.7-flash

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (https://platform.openai.com/) — also supports NVIDIA NIM API
# For NVIDIA NIM, set the base URL and API key once. The app sidebar can then
# select a separate strategy model and independent judge model per run.
#   OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENAI_MODEL=google/gemma-4-31b-it
# Supported sidebar choices: meta/llama-3.1-8b-instruct,
# e.g. meta/llama-3.1-8b-instruct or google/diffusiongemma-26b-a4b-it
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional NVIDIA NIM model-specific keys. These override OPENAI_API_KEY only
# for the matching model, letting you change/rotate them independently.
NVIDIA_DIFFUSIONGEMMA_API_KEY=
NVIDIA_NEMOTRON_API_KEY=
NVIDIA_REQUEST_TIMEOUT=120
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
