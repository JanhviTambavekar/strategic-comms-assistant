# Copy this file to .env and fill in ONE provider key.
# If none is set, the app runs in MOCK mode (no API needed) so the demo still works.

# LLM provider: "free", "groq", "openrouter", "gemini", "anthropic", "openai", or "mock"
# "free" exposes every configured free/free-tier service in one selector and
# fails over quickly when an endpoint is rate-limited or unavailable.
LLM_PROVIDER=mock
FREE_MODEL_TIMEOUT=12

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# OpenRouter free-model router (https://openrouter.ai/keys)
# Uses `openrouter/free`, which selects an available free model automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REQUEST_TIMEOUT=30

# Cloudflare Workers AI (10,000 free neurons/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-3-12b-it

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (https://platform.openai.com/) — also supports NVIDIA NIM API
# For NVIDIA NIM, set the base URL and API key once. The app sidebar can then
# select a separate strategy model and independent judge model per run.
#   OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENAI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Supported sidebar choices: meta/llama-3.1-8b-instruct,
# e.g. meta/llama-3.1-8b-instruct or google/diffusiongemma-26b-a4b-it
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional NVIDIA NIM model-specific keys. These override OPENAI_API_KEY only
# for the matching model, letting you change/rotate them independently.
# For three general NVIDIA keys, set NVIDIA_API_KEY_1, _2 and _3. The client
# de-duplicates these values and accepts an optional "Bearer " prefix.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_NEMOTRON_API_KEY=
NVIDIA_NEMOTRON_OMNI_API_KEY=
NVIDIA_GPT_OSS_API_KEY=
NVIDIA_MUSE_API_KEY=
NVIDIA_DIFFUSIONGEMMA_API_KEY=
NVIDIA_GEMMA_API_KEY=
NVIDIA_REQUEST_TIMEOUT=12
NVIDIA_EXPERIMENTAL_TIMEOUT=4
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
