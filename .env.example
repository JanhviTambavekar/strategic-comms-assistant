# Copy to .env. Never commit the populated .env file.

# Use "free" for live comparison or "mock" for the offline workflow.
LLM_PROVIDER=mock
FREE_MODEL_TIMEOUT=12

# Groq exposes the four comparison models in the application.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REQUEST_TIMEOUT=30

# Optional cross-provider fallback/comparator
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# Optional free/free-tier providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-3-12b-it

# Optional providers retained for explicit configurations
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
