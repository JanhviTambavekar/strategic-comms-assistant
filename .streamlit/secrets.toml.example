# Paste the relevant root-level entries into Streamlit Community Cloud's
# "Advanced settings" > "Secrets" field. Never commit a populated
# secrets.toml file.

# Choose exactly one provider: mock, gemini, anthropic, or openai.
LLM_PROVIDER = "gemini"

# Google Gemini
GOOGLE_API_KEY = "replace-with-your-key"
GOOGLE_MODEL = "gemini-3.7-flash"

# Alternative providers (uncomment only when selected above).
# ANTHROPIC_API_KEY = "replace-with-your-key"
# ANTHROPIC_MODEL = "claude-sonnet-4-6"
# OPENAI_API_KEY = "replace-with-your-key"
# OPENAI_MODEL = "gpt-4o-mini"
# OPENAI_BASE_URL = ""

# Optional NVIDIA NIM configuration when LLM_PROVIDER = "openai".
# OPENAI_BASE_URL = "https://integrate.api.nvidia.com/v1"
# NVIDIA_DIFFUSIONGEMMA_API_KEY = "replace-with-your-key"
# NVIDIA_NEMOTRON_API_KEY = "replace-with-your-key"
# NVIDIA_QWEN_API_KEY = "replace-with-your-key"
# NVIDIA_REQUEST_TIMEOUT = "120"
# NVIDIA_FALLBACK_MODEL = "meta/llama-3.1-8b-instruct"
